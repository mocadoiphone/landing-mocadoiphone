-- =============================================================================
-- Fixtures compartilhadas pelos testes pgTAP (incluídas com \ir).
-- Executadas como postgres dentro da transação de cada arquivo de teste
-- (tudo é desfeito no ROLLBACK). IDs fixos para referência nos testes.
--
-- Usuários:
--   ...0001 OWNER · ...0002 ADMIN · ...0003 CATALOG_MANAGER · ...0004 CONTENT_EDITOR
--   ...0005 autenticado sem perfil · ...0006 ADMIN inativo
-- =============================================================================

set client_min_messages to warning;
create extension if not exists pgtap with schema extensions;

insert into auth.users (id, email, aud, role, instance_id)
select u.id, u.email, 'authenticated', 'authenticated', '00000000-0000-0000-0000-000000000000'
from (values
  ('aaaaaaaa-0000-4000-8000-000000000001'::uuid, 'owner@tests.local'),
  ('aaaaaaaa-0000-4000-8000-000000000002'::uuid, 'admin@tests.local'),
  ('aaaaaaaa-0000-4000-8000-000000000003'::uuid, 'catalogo@tests.local'),
  ('aaaaaaaa-0000-4000-8000-000000000004'::uuid, 'conteudo@tests.local'),
  ('aaaaaaaa-0000-4000-8000-000000000005'::uuid, 'visitante@tests.local'),
  ('aaaaaaaa-0000-4000-8000-000000000006'::uuid, 'inativo@tests.local')
) as u (id, email);

insert into public.admin_profiles (user_id, display_name, role, is_active)
values
  ('aaaaaaaa-0000-4000-8000-000000000001', 'Owner de teste', 'OWNER', true),
  ('aaaaaaaa-0000-4000-8000-000000000002', 'Admin de teste', 'ADMIN', true),
  ('aaaaaaaa-0000-4000-8000-000000000003', 'Catálogo de teste', 'CATALOG_MANAGER', true),
  ('aaaaaaaa-0000-4000-8000-000000000004', 'Conteúdo de teste', 'CONTENT_EDITOR', true),
  ('aaaaaaaa-0000-4000-8000-000000000006', 'Inativo de teste', 'ADMIN', false);

-- Categorias: uma ativa, uma inativa.
insert into public.categories (id, name, slug, is_active)
values
  ('cccccccc-0000-4000-8000-000000000001', 'Categoria ativa', 't-ativa', true),
  ('cccccccc-0000-4000-8000-000000000002', 'Categoria inativa', 't-inativa', false);

insert into public.product_families (id, category_id, name, slug)
values
  ('dddddddd-0000-4000-8000-000000000001', 'cccccccc-0000-4000-8000-000000000001', 'Família ativa', 't-familia'),
  ('dddddddd-0000-4000-8000-000000000002', 'cccccccc-0000-4000-8000-000000000002', 'Família da inativa', 't-familia');

-- Produtos: rascunho, publicado e (mais abaixo) excluído.
