  ('88888888-0000-4000-8000-000000000002', 'Contato inativo', '5500000000002', false);

-- Configurações: uma pública e uma privada (independe do seed).
insert into public.site_settings (key, value_json)
values ('seo', '{"site_name": "Teste"}'), ('media', '{"video_upload_enabled": false}')
on conflict (key) do nothing;

-- Contato padrão determinístico: o contato ativo da fixture.
update public.contacts set is_default = false where is_default;
update public.contacts set is_default = true where id = '88888888-0000-4000-8000-000000000001';
