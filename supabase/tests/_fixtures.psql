values
  ('ffffffff-0000-4000-8000-000000000001', 'eeeeeeee-0000-4000-8000-000000000001', '128 GB', 'Preto', 500000, 'AVAILABLE', true),
  ('ffffffff-0000-4000-8000-000000000002', 'eeeeeeee-0000-4000-8000-000000000002', '256 GB', 'Preto', 899900, 'AVAILABLE', true),
  ('ffffffff-0000-4000-8000-000000000003', 'eeeeeeee-0000-4000-8000-000000000002', '512 GB', 'Preto', 999900, 'HIDDEN', false),
  ('ffffffff-0000-4000-8000-000000000004', 'eeeeeeee-0000-4000-8000-000000000003', '128 GB', 'Azul', 700000, 'AVAILABLE', true);

