  ('eeeeeeee-0000-4000-8000-000000000002', 'Tela', 'Tamanho', '6,9"');

update public.products set status = 'PUBLISHED'
where id in ('eeeeeeee-0000-4000-8000-000000000002', 'eeeeeeee-0000-4000-8000-000000000003');
update public.products set deleted_at = now() where id = 'eeeeeeee-0000-4000-8000-000000000003';

