# Copie para `.env.local` e preencha. Nunca versione arquivos .env reais.

# Supabase (MDI-D015, MDI-D017).
# Use a chave PÚBLICA (anon ou publishable `sb_publishable_…`): ela vai para o
# navegador e é protegida por RLS. A aplicação se recusa a iniciar se receber
# uma chave secreta (service_role / `sb_secret_…`) aqui.
#
# Desenvolvimento contra o Supabase local: coloque os valores de `supabase status`
# em `.env.development.local` (tem prioridade sobre `.env.local` no `npm run dev`).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
