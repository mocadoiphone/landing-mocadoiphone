# Copie para `.env.local` e preencha. Nunca versione `.env.local`.
# Etapa 01: todas opcionais — o projeto roda sem elas.

# Supabase (integração na Etapa 02).
# A chave pública (anon/publishable) vai para o navegador e é protegida por RLS.
# Nunca coloque a chave secreta/service role em variável NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
